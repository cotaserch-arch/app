# Copy this file to .env and fill in what you need. Everything is optional.

# Turns on the real AI (game previews, bot builder, big-moment commentary).
# Get a key at https://console.anthropic.com. Empty = built-in demo AI.
ANTHROPIC_API_KEY=

PORT=3000
DATA_FILE=data/db.json

# "auto" uses live ESPN games and falls back to the demo league.
# "espn" requires live data. "demo" always uses the demo league (fictional teams).
SPORTS_DATA=auto

# Set to false to start without sample fans and bots.
SEED_SAMPLES=true

# Secret for GET /api/admin/stats (signups, waitlist, reported messages). Use a long random string.
ADMIN_TOKEN=

# Shown in the privacy policy (required for the App Store).
CONTACT_EMAIL=

# --- Money ---
# Sportsbook affiliate link: adds "Bet it" buttons on the website for 21+ users
# in legal states. Never shown inside the iPhone/Android app.
SPORTSBOOK_NAME=
SPORTSBOOK_URL=
SPORTSBOOK_TERMS=21+ and present in a legal state. Gambling problem? Call 1-800-GAMBLER.

# Google AdSense (website only). Fill both to show real ads.
ADSENSE_CLIENT=
ADSENSE_SLOT=

# A directly sold sponsor, used in ad slots when AdSense isn't set.
SPONSOR_NAME=
SPONSOR_TEXT=
SPONSOR_URL=
