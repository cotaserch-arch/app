# Copy this file to .env and fill in your values.

# Turns on real AI (request writing + quote comparison). Get a key at https://console.anthropic.com
# Leave empty to run in demo mode.
ANTHROPIC_API_KEY=

PORT=3000

# Where requests and quotes are stored.
DATA_FILE=data/db.json

# Set to false to start with an empty marketplace instead of sample requests.
SEED_SAMPLES=true
