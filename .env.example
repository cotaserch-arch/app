# Copy this file to .env and fill in what you need. Everything is optional.

# Turns on real AI (strategy builder + coach). Get a key at https://console.anthropic.com
# Leave empty to run in demo mode.
ANTHROPIC_API_KEY=

PORT=3000

# Where bots and the waitlist are stored.
DATA_FILE=data/db.json

# Set to false to start with an empty league instead of sample bots.
SEED_SAMPLES=true

# "auto" uses live Coinbase prices and falls back to a simulated market.
# "simulated" always uses the simulated market.
MARKET_DATA=auto

# Secret for GET /api/admin/stats (bot counts + waitlist emails). Pick a long random string.
ADMIN_TOKEN=

# --- Money ---
# Google AdSense: fill both to show real ads in every ad slot.
ADSENSE_CLIENT=
ADSENSE_SLOT=

# A directly-sold sponsor (used when AdSense isn't set).
SPONSOR_NAME=
SPONSOR_TEXT=
SPONSOR_URL=
