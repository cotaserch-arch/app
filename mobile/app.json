{
  "expo": {
    "name": "Clutch",
    "slug": "clutch",
    "scheme": "clutch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05080f",
    "ios": {
      "bundleIdentifier": "com.sergiocota.clutch",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sergiocota.clutch",
      "adaptiveIcon": {
        "backgroundColor": "#05080f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "appUrl": "https://YOUR-CLUTCH-DOMAIN.com",
      "eas": {
        "projectId": "5e8bcbfe-1b1f-4527-a8a7-c7b57ab6263e"
      }
    },
    "owner": "macbob1818"
  }
}
